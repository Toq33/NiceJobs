# ==============================================================================
# NiceJobs Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit .env containing actual secrets or passwords to version control.
# ==============================================================================

# Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# For Local Development:
#   Leave blank or unset to use the local SQLite database (nicejobs.db).
#   Or set to your local/staging PostgreSQL connection string.
#
# For Vercel / Production Deployment:
#   MUST be set in the Vercel Dashboard under Project Settings > Environment Variables.
#   In production, NiceJobs enforces PostgreSQL and will NOT fall back to SQLite.
#
# Recommended Supabase Connection (Transaction Pooler - Port 6543):
#   postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Optional: Set environment mode ('development', 'staging', 'production')
# In production, NiceJobs strictly requires DATABASE_URL.
ENVIRONMENT=development

# Email / SMTP Configuration (Optional)
# If configured, real email notifications are dispatched; otherwise simulated in logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
